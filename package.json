{
  "name": "editorial-sistema",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "llamar": "tsx --env-file=.env paquetes/cliente/src/llamar.ts",
    "llamar:real": "CLAUDE_MODO=real npm run llamar",
    "peticion": "tsx paquetes/cliente/src/ver-peticion.ts",
    "caso": "tsx --env-file=.env paquetes/cliente/src/caso.ts",
    "caso:real": "CLAUDE_MODO=real npm run caso --",
    "presupuesto": "tsx paquetes/cliente/src/presupuesto.ts",
    "verificar": "tsx paquetes/cliente/src/verificar-citas.ts",
    "costos": "tsx paquetes/cliente/src/costos.ts",
    "costos:escribir": "tsx paquetes/cliente/src/escribir-costos.ts",
    "prefijo": "tsx paquetes/cliente/src/ver-prefijo.ts",
    "version-fija": "tsx paquetes/cliente/src/version-fija.ts",
    "cache": "tsx --env-file=.env paquetes/cliente/src/medir-cache.ts",
    "cache:real": "CLAUDE_MODO=real npm run cache",
    "en-vivo": "tsx paquetes/cliente/src/en-vivo.ts",
    "crear-pdf": "tsx paquetes/cliente/src/crear-pdf.ts",
    "documento": "tsx paquetes/cliente/src/documento.ts",
    "mapa": "tsx herramientas/verificar-mapa.ts",
    "capas": "tsx herramientas/verificar-capas.ts",
    "ajustes": "tsx herramientas/verificar-ajustes.ts",
    "permisos": "tsx herramientas/revisar-permisos.ts",
    "conversar": "tsx --env-file=.env paquetes/cliente/src/herramientas/conversar.ts",
    "conversar:real": "CLAUDE_MODO=real npm run conversar --",
    "test:herramientas": "tsx --test paquetes/cliente/src/herramientas/*.test.ts",
    "ficha": "tsx --env-file=.env paquetes/extractor/src/extraer.ts",
    "validar": "tsx paquetes/extractor/src/validar.ts",
    "lote": "tsx --env-file=.env paquetes/extractor/src/lote.ts",
    "test:extractor": "tsx --test paquetes/extractor/src/*.test.ts",
    "catalogo": "tsx paquetes/catalogo-mcp/src/main.ts",
    "catalogo:probar": "tsx paquetes/catalogo-mcp/src/probar.ts",
    "bucle": "tsx --env-file=.env paquetes/asistente/src/bucle.ts",
    "bucle:real": "CLAUDE_MODO=real npm run bucle --",
    "test:asistente": "tsx --test --test-reporter=tap paquetes/asistente/src/*.test.ts",
    "asistente": "tsx --env-file=.env paquetes/asistente/src/asistente.ts",
    "skills": "tsx herramientas/verificar-skills.ts",
    "agentes": "tsx herramientas/verificar-agentes.ts",
    "investigar": "tsx --env-file=.env paquetes/asistente/src/investigacion/investigar.ts",
    "investigar:real": "CLAUDE_MODO=real npm run investigar --",
    "test:investigacion": "tsx --test --test-reporter=tap paquetes/asistente/src/investigacion/*.test.ts",
    "triage": "tsx --env-file=.env paquetes/asistente/src/triage/triage.ts",
    "triage:real": "CLAUDE_MODO=real npm run triage --",
    "test:triage": "tsx --test --test-reporter=tap paquetes/asistente/src/triage/*.test.ts",
    "plugin": "tsx herramientas/verificar-plugin.ts",
    "plugin:armar": "tsx herramientas/verificar-plugin.ts --armar",
    "mod": "claude plugin validate mods/panel-editorial && claude plugin test mods/panel-editorial",
    "workflows": "tsx herramientas/verificar-workflows.ts",
    "revision": "tsx herramientas/revision.ts",
    "test:revision": "tsx --test --test-reporter=tap herramientas/hallazgos.test.ts",
    "test": "tsx --test paquetes/cliente/src/*.test.ts paquetes/cliente/src/herramientas/*.test.ts paquetes/extractor/src/*.test.ts paquetes/asistente/src/*.test.ts paquetes/asistente/src/investigacion/*.test.ts paquetes/asistente/src/triage/*.test.ts herramientas/hallazgos.test.ts && npm run capas && npm run ajustes && npm run permisos && npm run skills && npm run agentes && npm run plugin && npm run workflows",
    "tipos": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.301",
    "@anthropic-ai/sdk": "0.135.0",
    "@modelcontextprotocol/server": "2.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
