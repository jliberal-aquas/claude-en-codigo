---
import Base from "../layouts/Base.astro";
import Encabezado from "../components/Encabezado.astro";
import Pie from "../components/Pie.astro";
import Titulo from "../components/Titulo.astro";
import BloqueAutora from "../components/BloqueAutora.astro";
import Boton from "../components/Boton.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<Base titulo="Sofía | Ediciones del Patio">
  <Encabezado />
  <main class="mx-auto w-full max-w-4xl flex-1 space-y-8 px-4 py-8">
    <h1 class="font-display text-4xl" style="color:#2b2118">Sofía</h1>
    <section>
      <Titulo texto="La autora" />
      <BloqueAutora />
      <p class="mt-4">
        De ella no publicamos foto ni apellido: solo lo que aceptó que se contara.
      </p>
    </section>
    <Boton href={`${base}/libro/`}>Ver su libro</Boton>
  </main>
  <Pie />
</Base>
