---
// La ficha del libro. La usan la portada (pequeña) y la página del
// libro (grande); antes eran dos componentes: este y LibroCard.astro.
import { libro } from "../data/libro";
interface Props {
  grande?: boolean;
  alt?: string;
}
const { grande = false, alt = `Portada de ${libro.titulo}` } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<article class="flex gap-4 rounded-lg border border-stone-300 bg-white p-4">
  <img
    src={`${base}/portada-la-puerta-azul.svg`}
    alt={alt}
    width={grande ? 150 : 90}
    height={grande ? 210 : 126}
    class={grande ? "h-auto w-36 shrink-0" : "h-auto w-24 shrink-0"}
  />
  <div>
    <h3 class="font-display text-xl" style="color:#2b2118">{libro.titulo}</h3>
    <p class="text-sm" style="color:#6b5a45">de {libro.autora}</p>
    <p class="mt-2">{libro.resumen}</p>
  </div>
</article>
